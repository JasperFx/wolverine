<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- CentralPackageTransitivePinningEnabled is deliberately NOT set, so every PackageVersion
         below reaches only the projects that reference the package *directly* (plus whatever they
         flow it to over a ProjectReference). A pin on its own does NOT lift a package that arrives
         purely transitively. Where a pin has to beat a transitive floor, the lever used throughout
         this file is an explicit PackageReference in the project that needs it — see the SSH.NET,
         Microsoft.CodeAnalysis.CSharp.Workspaces and Weasel.Storage notes below.

         Turning transitive pinning on is a deliberate NO, settled on GH-4768 by measurement. Two
         costs decided it. First, pinning collapses every version *range* below to its floor, so
         the compatibility ranges on core WolverineFx's Microsoft.Extensions.* dependencies would
         have to be replaced by raised hard floors — including Microsoft.Extensions.Hosting.Abstractions
         10.0.0 on net9.0, forced by Fisher/Polecat, plus Microsoft.Data.SqlClient 7.0.0 and Npgsql
         10.x on net10.0. Second, pinning promotes every pinned transitive package into the
         *published* nuspec as a direct dependency: WolverineFx.RabbitMQ measured 3 published
         dependencies with pinning off and 19 with it on. Seeing transitive exposure is better
         answered by NuGetAuditMode (GH-4773) at none of that cost. -->
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Alba" Version="9.0.0" />
    <!-- The .NET Aspire samples (src/Samples/AspireWithRabbitMq, src/Samples/AspireWithKafka). Keep these on
         the same version as the Aspire.AppHost.Sdk those AppHost projects declare. -->
    <PackageVersion Include="Aspire.Hosting.Kafka" Version="13.6.5" />
    <PackageVersion Include="Aspire.Hosting.RabbitMQ" Version="13.6.5" />
    <PackageVersion Include="Asp.Versioning.Abstractions" Version="[10.0.0,12.0.0)" />
    <PackageVersion Include="Asp.Versioning.Http" Version="[10.0.0,12.0.0)" />
    <PackageVersion Include="Asp.Versioning.Mvc.ApiExplorer" Version="[10.0.0,12.0.0)" />
    <PackageVersion Include="AWSSDK.S3" Version="4.0.22.1" />
    <PackageVersion Include="AWSSDK.SimpleNotificationService" Version="4.0.2.14" />
    <PackageVersion Include="AWSSDK.SQS" Version="4.0.2.14" />
    <PackageVersion Include="Azure.Identity" Version="1.17.0" />
    <PackageVersion Include="Azure.Messaging.ServiceBus" Version="7.20.1" />
    <PackageVersion Include="Azure.Storage.Blobs" Version="12.27.0" />
    <PackageVersion Include="Apache.Avro" Version="1.12.1" />
    <PackageVersion Include="BenchmarkDotNet" Version="0.13.1" />
    <PackageVersion Include="Confluent.Kafka" Version="2.14.0" />
    <PackageVersion Include="Confluent.SchemaRegistry.Serdes.Avro" Version="2.14.0" />
    <PackageVersion Include="Confluent.SchemaRegistry.Serdes.Json" Version="2.14.0" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
    <PackageVersion Include="Dekaf" Version="1.25.0" />
    <PackageVersion Include="Dekaf.SchemaRegistry" Version="1.25.0" />
    <PackageVersion Include="Dekaf.SchemaRegistry.Avro" Version="1.25.0" />
    <PackageVersion Include="Dekaf.SchemaRegistry.Json" Version="1.25.0" />
    <PackageVersion Include="DotPulsar" Version="5.1.2" />
    <PackageVersion Include="FluentResults" Version="3.16.0" />
    <PackageVersion Include="FluentValidation" Version="12.0.0" />
    <PackageVersion Include="FSharp.Core" Version="9.0.303" />
    <PackageVersion Include="GitHubActionsTestLogger" Version="2.4.1" />
    <PackageVersion Include="Google.Api.CommonProtos" Version="2.16.0" />
    <PackageVersion Include="Google.Cloud.PubSub.V1" Version="3.24.0" />
    <PackageVersion Include="Google.Cloud.Storage.V1" Version="4.13.0" />
    <PackageVersion Include="Google.Protobuf" Version="3.31.1" />
    <PackageVersion Include="Grpc.AspNetCore" Version="2.76.0" />
    <PackageVersion Include="Grpc.Core" Version="2.46.6" />
    <PackageVersion Include="Grpc.Core.Api" Version="2.76.0" />
    <PackageVersion Include="Grpc.Net.Client" Version="2.76.0" />
    <PackageVersion Include="Grpc.Net.ClientFactory" Version="2.76.0" />
    <PackageVersion Include="Grpc.StatusProto" Version="2.76.0" />
    <PackageVersion Include="Grpc.Tools" Version="2.76.0" />
    <PackageVersion Include="HtmlTags" Version="9.0.0" />
    <!-- Drives test-host executables as supervised worker processes from the Nuke build
         (build/SupervisedTests.cs): class-partitioned parallel workers, per-lane environments,
         and honest retry reporting. Referenced ONLY by the build project. -->
    <PackageVersion Include="Bobcat.Supervisor" Version="1.0.0" />
    <!-- Bobcat itself, for the leadership-election compliance specifications in Wolverine.ComplianceTests and
         for WolverineFx.Bobcat / WolverineFx.Bobcat.Http, their tests and the samples that dogfood them (GH-4833).
         Everything that takes Bobcat is on one version; the 0.60.4 hold for WolverineFx.Bobcat ended with
         1.0.0-rc.1, which fixed JasperFx/bobcat#672. -->
    <PackageVersion Include="Bobcat" Version="1.0.0" />
    <PackageVersion Include="Bobcat.Xunit" Version="1.0.0" />
    <PackageVersion Include="Bobcat.Generators" Version="1.0.0" />
    <!-- The eventmodelers.ai board reader WolverineFx.Bobcat.EventModel's spec writer reads with (GH-5082) -->
    <PackageVersion Include="Bobcat.EventModel" Version="1.0.0" />
  </ItemGroup>
  <ItemGroup>
    <PackageVersion Include="JasperFx" Version="3.0.1" />
    <PackageVersion Include="JasperFx.Events" Version="3.0.1" />
    <PackageVersion Include="JasperFx.Events.SourceGenerator" Version="3.0.1" />
    <PackageVersion Include="JasperFx.Events.InMemory" Version="3.0.1" />
    <!-- RuntimeCompiler is on its own line (the Roslyn compiler package), not the JasperFx one:
         6.0.0 goes with JasperFx 3.0 (net10.0;net11.0, Roslyn 5.9). 5.0.1 was jasperfx#1086,
         AssemblyGenerator sharing one Roslyn MetadataReference per assembly path across
         compilations instead of re-reading every referenced PE image into native memory each time. -->
    <PackageVersion Include="JasperFx.RuntimeCompiler" Version="6.0.0" />
    <PackageVersion Include="JasperFx.SourceGenerator" Version="3.0.1" />
    <PackageVersion Include="Lamar.Microsoft.DependencyInjection" Version="16.0.0" />
    <PackageVersion Include="Marten" Version="10.0.0-alpha.1" />
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <PackageVersion Include="Polecat" Version="6.0.0-alpha.1" />
    <PackageVersion Include="Fisher" Version="2.0.0-alpha.1" />
    <PackageVersion Include="Microsoft.Azure.Cosmos" Version="3.63.2" />
    <PackageVersion Include="Marten.AspNetCore" Version="10.0.0-alpha.1" />
    <PackageVersion Include="Marten.Newtonsoft" Version="10.0.0-alpha.1" />
    <PackageVersion Include="MemoryPack" Version="1.21.3" />
    <PackageVersion Include="MessagePack" Version="3.1.12" />
    <PackageVersion Include="Meziantou.Extensions.Logging.Xunit" Version="1.0.15" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="9.0.14" />
    <!-- GHSA-334f-vvp4-7g6p / CVE-2026-70159 (HIGH, NU1903): SignalR.Client 9.0.8 brings
         Microsoft.AspNetCore.SignalR.Common 9.0.8, patched in 9.0.21 and 10.0.13. Each TFM takes
         its own servicing line. -->
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.13" Condition="'$(TargetFramework)' == 'net10.0'" />
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Client" Version="11.0.0" Condition="'$(TargetFramework)' == 'net11.0'" />
    <PackageVersion Include="Microsoft.Azure.SignalR" Version="1.32.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="3.11.0" />
    <PackageVersion Include="Microsoft.Extensions.AI.Abstractions" Version="10.9.0" />
    <PackageVersion Include="Microsoft.Extensions.ApiDescription.Server" Version="9.0.5" />
    <PackageVersion Include="Microsoft.FeatureManagement" Version="3.2.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <!-- SourceLink 8.0.0 pulls Microsoft.Build.Tasks.Git 8.0.0 exactly, which carries
         GHSA-23fw-v26w-5fgq. It arrives with PrivateAssets="All" from Directory.Build.props, so the
         transitive cannot be pinned around; the SourceLink version is the only lever. 10.0.401
         resolves it to Microsoft.Build.Tasks.Git 10.0.401; the lowest stable clear of the advisory
         is 10.0.204, so there is no smaller step. Build-time only, nothing ships from it. -->
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.401" />
    <PackageVersion Include="Microsoft.VisualStudio.Threading.Analyzers" Version="17.0.64" />
    <PackageVersion Include="MQTTnet" Version="5.2.0.1603" />
    <PackageVersion Include="MQTTnet.Server" Version="5.2.0.1603" />
    <!-- 2.6.1, not 2.4.0, and this is REQUIRED rather than tidy: Weasel.MySql 9.48.0 declares
         MySqlConnector >= 2.6.1, so at 2.4.0 the restore fails with NU1605, a package downgrade
         promoted to an error. Weasel took it for GHSA-473q-m89c-ghf8 (weasel#767), so the advisory
         closes for WolverineFx.MySql here too. -->
    <PackageVersion Include="MySqlConnector" Version="2.6.1" />
    <PackageVersion Include="NATS.Net" Version="3.3.2" />
    <!-- The cron EXPRESSION PARSER behind opts.Schedules (recurring messages). A parser, not a
         scheduling engine — Wolverine's own scheduled-message machinery is the engine. MIT, zero
         transitive dependencies, correct DST handling. In core by explicit decision (CritterWatch
         planning 2026-09-04) rather than a satellite package. -->
    <PackageVersion Include="Cronos" Version="0.11.0" />
    <PackageVersion Include="NewId" Version="4.0.1" />
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <PackageVersion Include="NSubstitute" Version="5.3.0" />
    <PackageVersion Include="NuGet.Packaging" Version="6.14.3" />
    <PackageVersion Include="Nuke.Common" Version="10.1.0" />
    <PackageVersion Include="NSwag.AspNetCore" Version="14.0.0" />
    <PackageVersion Include="OpenTelemetry" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Api" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Exporter.Console" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Exporter.InMemory" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.20.2" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.20.2" />
    <PackageVersion Include="Oracle.ManagedDataAccess.Core" Version="23.26.400" />
    <PackageVersion Include="protobuf-net.BuildTools" Version="3.2.52" />
    <PackageVersion Include="protobuf-net.Grpc" Version="1.2.2" />
    <PackageVersion Include="protobuf-net.Grpc.AspNetCore" Version="1.2.2" />
    <PackageVersion Include="RabbitMQ.Client" Version="7.2.2" />
    <PackageVersion Include="RavenDB.Client" Version="7.0.2" />
    <PackageVersion Include="RavenDB.DependencyInjection" Version="5.0.1" />
    <PackageVersion Include="RavenDB.TestDriver" Version="7.0.2" />
    <PackageVersion Include="Refit" Version="8.0.0" />
    <PackageVersion Include="Refit.HttpClientFactory" Version="8.0.0" />
    <PackageVersion Include="Scalar.AspNetCore" Version="2.14.8" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="Spectre.Console" Version="0.55.0" />
    <PackageVersion Include="StackExchange.Redis" Version="2.9.17" />
    <PackageVersion Include="StronglyTypedId" Version="1.0.0-beta08" />
    <!-- Swashbuckle.AspNetCore and Microsoft.OpenApi are pinned PER TFM, in the TFM-conditional groups at
         the bottom of this file, because the two lines must move together (GH-5149):
           net10.0: Swashbuckle 10.x on the Microsoft.OpenApi 2.x object model (Swashbuckle 10 floors it at
                    2.7.5, the GHSA-v5pm-xwqc-g5wc fix; the repo pins 2.13.x)
           net11.0: Swashbuckle 11.x on the Microsoft.OpenApi 3.x object model (Microsoft.AspNetCore.OpenApi 11
                    floors it at >= 3.10.2 and Swashbuckle 11 at 3.11.0; GH-5132)
         Swashbuckle 10 has no net11.0 build and is compiled against 2.x, so it must not reach net11.0, and
         Swashbuckle 11 asks for 3.11.0 on net10.0 too, which the 2.x pin there would refuse as a downgrade.
         The projects that reference Microsoft.AspNetCore.OpenApi get the Microsoft.OpenApi pin directly
         from Directory.Build.targets; Swashbuckle-only projects resolve its floor transitively. -->
    <PackageVersion Include="System.ComponentModel" Version="4.3.0" />
    <!-- 10.0.7 carries a known HIGH severity advisory (NU1903). -->
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.12" />
    <!-- GHSA-846f-f764-76mx / CVE-2026-84008 (HIGH, NU1903: .NET denial of service) covers
         System.Security.Cryptography.Pkcs 8.0.0-8.0.1, 9.0.0-9.0.20 and 10.0.0-10.0.12. It arrives
         transitively through Microsoft.Data.SqlClient, Oracle.ManagedDataAccess.Core and Polecat
         (8.0.0, 9.0.4, 9.0.13) on BOTH target frameworks - nothing prunes it on net10.0. So
         Wolverine.SqlServer, Wolverine.Oracle and Wolverine.ClaimCheck.SqlServer reference it
         directly, and everything downstream of them gets the patched version. Each TFM takes its
         own servicing line. Transitive pinning stays off (see the top of this file).
         Weasel 9.45.1 and Polecat 5.40.2 now carry the same patched floor themselves, but these
         pins stay: Wolverine references Microsoft.Data.SqlClient and Oracle.ManagedDataAccess.Core
         directly, and neither driver depends on a patched Pkcs yet. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" Condition="'$(TargetFramework)' == 'net10.0'" />
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="11.0.0" Condition="'$(TargetFramework)' == 'net11.0'" />
    <!-- Testcontainers pulls SSH.NET [2025.1.0, ); everything through 2025.1.0 carries
         GHSA-q939-rpr3-3284. The test projects that use Testcontainers reference this directly so
         the patched version wins. -->
    <PackageVersion Include="SSH.NET" Version="2026.0.0" />
    <PackageVersion Include="Testcontainers" Version="4.12.0" />
    <PackageVersion Include="Testcontainers.CosmosDb" Version="4.12.0" />
    <PackageVersion Include="Testcontainers.Kafka" Version="4.12.0" />
    <PackageVersion Include="Testcontainers.LocalStack" Version="4.12.0" />
    <PackageVersion Include="Testcontainers.MsSql" Version="4.12.0" />
    <PackageVersion Include="Testcontainers.Nats" Version="4.12.0" />
    <PackageVersion Include="Testcontainers.Pulsar" Version="4.12.0" />
    <PackageVersion Include="Testcontainers.Redis" Version="4.12.0" />
    <PackageVersion Include="Testcontainers.ServiceBus" Version="4.12.0" />
    <PackageVersion Include="System.Diagnostics.DiagnosticSource" Version="9.0.5" />
    <PackageVersion Include="System.Net.NameResolution" Version="4.3.0" />
    <PackageVersion Include="System.Threading.Tasks.Dataflow" Version="9.0.5" />
    <!-- 9.47.1 is weasel#751, and it is the fix for wolverine#5215. Wolverine keeps its envelope
         tables in the service's own schema, and Weasel's PostgreSQL index introspection identified
         each row's table by regclassout's rendering of it, matched against four spellings, none of
         which quoted the SCHEMA. regclassout quotes whatever has to be quoted, so once wolverine#5216
         quoted the schema in Wolverine's own SQL, a service whose schema was a reserved word (order,
         user) read back no indexes at all: every declared index was Missing rather than Different,
         the patch was a bare create index, and the second startup failed with 42P07 and took the
         rest of the migration with it. A schema name carrying uppercase broke identically. Inert for
         a lower-case unquoted schema, where relname and the rendering name the same table. Nothing
         public added, removed or changed. -->
    <!-- Weasel 9.48.0 (from 9.47.1). ADOPTED as-is, no Wolverine code changes. Wolverine pins all

         The JasperFx floor: Weasel.Core 9.48.0 declares JasperFx >= 2.98.0 and Weasel.Storage
         declares JasperFx.Events >= 2.98.0, both read from the published nuspec. Already satisfied
         here, because the JasperFx 2.98.0 bump landed on its own ahead of this one; at 2.97.0 the
         restore fails outright with NU1605, a package downgrade promoted to an error, rather than
         resolving quietly upward.
         eight packages, so it has the widest surface of the four consumers, but most of this release
         lands on paths Wolverine does not take.

         weasel#758/#759: the parameter-type catch-all. A private helper in five providers ended in
         `?? <catch-all>`, which can never return null, so every fall-through branch after the first
         was dead code. On SQL Server the catch-all went out as sql_variant, which outranks every
         ordinary type in data type precedence, so comparing one against a column converted THE COLUMN
         once per row. Wolverine does not call ToParameterType itself; it hands
         SqlServerProvider.Instance and PostgresqlProvider.Instance to the Weasel base classes, so
         what it gets is the corrected resolution underneath. Worth knowing: on SQL Server, Guid was
         already mapped, but short, byte, float, char, DateOnly and TimeOnly were not, and DateTime
         resolved to SqlDbType.Date, which dropped the time of day on a bound value. Both are fixed,
         and the generated datetime COLUMN type is unchanged, so no envelope table produces a schema
         diff.

         weasel#766: sp_getapplock was told its wait through @LockTimeout but ran under the
         connection's CommandTimeout, 30 seconds by default, so a requested wait of 30s or more
         silently had no effect and at exactly 30s a busy lock threw a raw SqlException instead of
         returning a failed AttainLockResult. Latent rather than live for Wolverine as it stands:
         SqlServerMessageStore.DurabilityPass passes lockTimeoutMs 0, and the other SQL Server call
         sites take the 1000ms default, so none of them was anywhere near the cap. It matters if
         SharedLockExtensions.DefaultLockTimeoutMilliseconds is ever raised past 30 seconds, which
         before this release would have had no effect.

         weasel#763: DateOnly and TimeOnly now map on MySQL (Date / Time, verified by round trip) and
         are REFUSED on Oracle, where ODP.NET has no conversion for either CLR type against any
         OracleDbType. Wolverine.MySql and Wolverine.Oracle bind neither type, so this is inert here;
         it is a new NotSupportedException on a path that previously sent a culture-dependent string.

         weasel#761: an enum parameter resolves by EnumStorage now, defaulting to the integer type,
         and arrays defer to the driver on SQL Server, SQLite, MySQL and Oracle instead of binding as
         a character type. PostgreSQL and Firebird keep Integer for an int-backed enum. Nothing in
         Wolverine routes an enum or an array through the provider seam.

         INERT: weasel#762 (SQL Server string Unicode precedence, documentation only), weasel#764 and
         weasel#765 (SQL Server and PostgreSQL partitioning; Wolverine partitions nothing).

         MySqlConnector moves to 2.6.1 as part of this, and not optionally: Weasel.MySql 9.48.0
         declares a floor of 2.6.1, so the restore fails with NU1605 at the 2.4.0 this repo pinned.
         Weasel took it for GHSA-473q-m89c-ghf8 (weasel#767), so that advisory closes for
         WolverineFx.MySql here too. -->
    <PackageVersion Include="Weasel.Core" Version="10.0.0-alpha.1" />
    <PackageVersion Include="Weasel.EntityFrameworkCore" Version="10.0.0-alpha.1" />
    <PackageVersion Include="Weasel.MySql" Version="10.0.0-alpha.1" />
    <PackageVersion Include="Weasel.Oracle" Version="10.0.0-alpha.1" />
    <PackageVersion Include="Weasel.Postgresql" Version="10.0.0-alpha.1" />
    <PackageVersion Include="Weasel.SqlServer" Version="10.0.0-alpha.1" />
    <PackageVersion Include="Weasel.Sqlite" Version="10.0.0-alpha.1" />
    <!-- The eighth Weasel package, and the only one nothing referenced directly. Marten, Polecat and
         Fisher each request the Weasel.Storage matching their own Weasel line, which trails the
         version pinned for the seven siblings — so before this pin the solution ran Weasel.Storage
         against a newer Weasel.Core than it was built against. Keep it on the same version as the
         siblings whenever that line moves. Wolverine.Marten/.Polecat/.Fisher/.ClaimCheck.Marten
         reference it directly so the pin actually wins; without transitive pinning a PackageVersion
         on its own would be inert here, since nothing else references it. -->
    <PackageVersion Include="Weasel.Storage" Version="10.0.0-alpha.1" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <!-- xUnit v3. Test projects use xunit.v3 and must set <OutputType>Exe</OutputType>.
         Shared/base-class libraries that are referenced by test projects (notably
         Wolverine.ComplianceTests) use xunit.v3.extensibility.core instead so they stay
         plain netstandard2.0 libraries. See XUNIT3-MIGRATION-PLAN.md.

         GH-4979: the whole repo is on xunit.v3 4.x, which runs on Microsoft.Testing.Platform 2.x
         (xunit.v3 4.0.2 brings platform 2.5.1, the same line Bobcat.Xunit 0.60.0 builds against).
         The two move TOGETHER: a 3.x xunit.v3 beside platform 2.x fails at run time, which is why
         every project moved at once rather than only the Bobcat.Xunit ones. Platform 2.x refuses
         the VSTest bridge on the .NET 10 SDK, so the root global.json puts `dotnet test` in the
         platform's own mode, where the project or solution is named with an option and never as a
         positional path (CLAUDE.md, Build & Test, has the commands).
         Microsoft.NET.Test.Sdk and xunit.runner.visualstudio stay on the test projects for IDE
         discovery only (Rider, Visual Studio Test Explorer); CI runs the test host executables
         through Bobcat's supervisor (build/SupervisedTests.cs). -->
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="xunit.v3.assert" Version="4.0.2" />
    <PackageVersion Include="xunit.v3.extensibility.core" Version="4.0.2" />
  </ItemGroup>
  <!-- TFM-conditional Microsoft.Extensions.* for Wolverine core (version ranges for NuGet compatibility) -->
  <!-- net11.0 (GH-5134). Microsoft.OpenApi 3.x is a different object model from 2.x (GH-5132), and
       Microsoft.AspNetCore.OpenApi 11 requires >= 3.10.2. Npgsql.EntityFrameworkCore.PostgreSQL has no
       11.0 GA on nuget.org yet, so net11.0 takes its newest release candidate. -->
  <ItemGroup Condition=" '$(TargetFramework)' == 'net11.0' ">
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="11.0.0" />
    <PackageVersion Include="Microsoft.OpenApi" Version="3.11.0" />
    <PackageVersion Include="Swashbuckle.AspNetCore" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Caching.Memory" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks.Abstractions" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.ObjectPool" Version="11.0.0" />
  </ItemGroup>
  <ItemGroup Condition=" '$(TargetFramework)' == 'net10.0' ">
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.0" />
    <PackageVersion Include="Microsoft.OpenApi" Version="2.13.0" />
    <PackageVersion Include="Swashbuckle.AspNetCore" Version="10.3.1" />
    <PackageVersion Include="Microsoft.Extensions.Caching.Memory" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks.Abstractions" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.ObjectPool" Version="10.0.2" />
  </ItemGroup>
  <!-- EF Core, its Npgsql provider and Roslyn stay on the 10.x line on net11.0 too (GH-5134).
       Npgsql.EntityFrameworkCore.PostgreSQL has only an 11.0.0 release candidate, which pins
       Microsoft.EntityFrameworkCore to the exact RC build and so cannot sit beside the GA 11.0.0 that
       published WolverineFx.EntityFrameworkCore would need (and NU5104 refuses a stable package with a
       prerelease dependency); EF Core 11's Design package also brings Roslyn 5.9.0 against the exact
       5.0.0 JasperFx.RuntimeCompiler asks for. The 10.x packages run on the net11.0 runtime. Moving this
       group to EF Core 11 is a follow-up once Npgsql ships 11.0 GA. -->
  <ItemGroup Condition=" '$(TargetFramework)' == 'net10.0' Or '$(TargetFramework)' == 'net11.0' ">
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.4" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.4" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.4" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.4" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.0" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <!-- JasperFx.RuntimeCompiler 6.0.0 asks for Microsoft.CodeAnalysis 5.9.0 on these frameworks.
         EF Core Design 10.0.4 brings CSharp.Workspaces and Workspaces.MSBuild 5.0.0, each requiring
         Workspaces.Common at EXACTLY its own version, so the Workspaces pair is lifted to 5.9.0 with
         it; Wolverine.EntityFrameworkCore references both directly so these pins reach them (transitive
         pinning is off, see the top of this file). -->
    <PackageVersion Include="Microsoft.CodeAnalysis.Common" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="5.9.0" />
  </ItemGroup>
</Project>
