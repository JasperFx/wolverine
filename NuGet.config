<?xml version="1.0" encoding="utf-8"?>
<!--
  TEMPORARY (GH-5082): a local preview of Bobcat 1.0.0-rc.2 (JasperFx/bobcat#755), the first Bobcat
  without the Critter Stack vocabulary this repo now ships in WolverineFx.Bobcat. Delete this file and
  move the Bobcat versions in Directory.Packages.props to the published 1.0.0-rc.2 before merging.
-->
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="bobcat-local-preview" value="/Users/jeremymiller/code/bobcat-main/artifacts/local-feed" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="bobcat-local-preview">
      <package pattern="Bobcat" />
      <package pattern="Bobcat.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
