<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFrameworks>net10.0</TargetFrameworks>
        <OpenApiGenerateDocumentsOnBuild>false</OpenApiGenerateDocumentsOnBuild>
        <!-- GH-5134: this fixture, Wolverine.Http.Tests and the Swashbuckle filters in here are written against
             the Microsoft.OpenApi 1.x object model (Swashbuckle 6.5.0). It was net9.0 only, where
             Microsoft.AspNetCore.OpenApi 9.0.5 resolves 1.6.17; moving to net10.0 must not drag in the 2.x
             model, so it holds Microsoft.AspNetCore.OpenApi at 9.0.5 and Directory.Build.targets skips its
             Microsoft.OpenApi pin. Porting to the 2.x/3.x model (Swashbuckle 10) is the Swashbuckle/OpenApi
             upgrade issue, not this one. -->
        <HoldMicrosoftOpenApi1x>true</HoldMicrosoftOpenApi1x>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="FSharp.Core" />
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" VersionOverride="9.0.5" />
        <PackageReference Include="Scalar.AspNetCore" />
        <PackageReference Include="Shouldly" />
        <PackageReference Include="StronglyTypedId" />
        <PackageReference Include="Swashbuckle.AspNetCore" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\WolverineWebApiFSharp\WolverineWebApiFSharp.fsproj" />
        <ProjectReference Include="..\..\Persistence\Wolverine.EntityFrameworkCore\Wolverine.EntityFrameworkCore.csproj" />
        <ProjectReference Include="..\..\Persistence\Wolverine.Marten\Wolverine.Marten.csproj" />
        <ProjectReference Include="..\Wolverine.AdminApi\Wolverine.AdminApi.csproj" />
        <ProjectReference Include="..\Wolverine.Http.FluentValidation\Wolverine.Http.FluentValidation.csproj" />
        <ProjectReference Include="..\Wolverine.Http.Marten\Wolverine.Http.Marten.csproj" />
        <ProjectReference Include="..\Wolverine.Http.Tests.DifferentAssembly\Wolverine.Http.Tests.DifferentAssembly.csproj" />
        <ProjectReference Include="..\Wolverine.Http\Wolverine.Http.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.EntityFrameworkCore" />
        <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    </ItemGroup>

    <ItemGroup>
        <Compile Include="..\..\Servers.cs">
            <Link>Servers.cs</Link>
        </Compile>
    </ItemGroup>

</Project>
