<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="xunit.v3"/>
        <!-- Runs LeadershipElectionCompliance, which is written as Bobcat specifications: the session hook
             (Bobcat.Xunit's props) and the generator that binds each inherited specification to this suite. -->
        <PackageReference Include="Bobcat.Xunit" />
        <PackageReference Include="Bobcat.Generators" />
        <PackageReference Include="GitHubActionsTestLogger" PrivateAssets="All" />
        <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="All"/>
        <PackageReference Include="coverlet.collector" PrivateAssets="All" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\..\Persistence\Wolverine.Marten\Wolverine.Marten.csproj"/>
        <ProjectReference Include="..\..\..\Testing\Wolverine.ComplianceTests\Wolverine.ComplianceTests.csproj" />
        <ProjectReference Include="..\Wolverine.AzureServiceBus\Wolverine.AzureServiceBus.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <Compile Include="..\..\..\Servers.cs">
            <Link>Servers.cs</Link>
        </Compile>
    </ItemGroup>

    <ItemGroup>
        <Content Include="$(SolutionDir)xunit.runner.json" CopyToOutputDirectory="PreserveNewest"/>
    </ItemGroup>
</Project>
