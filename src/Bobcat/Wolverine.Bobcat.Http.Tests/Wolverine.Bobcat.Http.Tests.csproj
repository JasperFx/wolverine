<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <!-- Alba 9 targets net10.0+ only -->
        <TargetFrameworks>net10.0</TargetFrameworks>
        <IsAotCompatible>false</IsAotCompatible>
        <OpenApiGenerateDocumentsOnBuild>false</OpenApiGenerateDocumentsOnBuild>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Bobcat.Xunit" />
        <!-- The source generator: marker comments, and the spec manifest the bobcat tool lists from -->
        <PackageReference Include="Bobcat.Generators" />
        <PackageReference Include="Shouldly" />
        <!-- Bobcat.Xunit 0.60.0 needs xunit.v3 4.x on Microsoft.Testing.Platform 2.x; the rest of the repo stays on 3.x -->
        <PackageReference Include="xunit.v3" VersionOverride="$(XunitV3ForBobcatVersion)" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Wolverine.Bobcat.Http\Wolverine.Bobcat.Http.csproj" />
        <ProjectReference Include="..\..\Http\Wolverine.Http.Marten\Wolverine.Http.Marten.csproj" />
        <ProjectReference Include="..\..\Wolverine.RuntimeCompilation\Wolverine.RuntimeCompilation.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Compile Include="..\..\Servers.cs">
            <Link>Servers.cs</Link>
        </Compile>
    </ItemGroup>

</Project>
