<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <Description>Writes WolverineFx.Bobcat specifications, and the spec project around them, from an eventmodelers.ai board export: one specification per example on the board, bound to its Event Model slice. The write-specs command, next to Wolverine's scaffold.</Description>
        <PackageId>WolverineFx.Bobcat.EventModel</PackageId>
        <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
        <LangVersion>13</LangVersion>
        <!-- Design-time tooling: exempt from the AOT compliance the shipping runtime packages carry -->
        <IsAotCompatible>false</IsAotCompatible>
        <NoWarn>$(NoWarn);CS0419</NoWarn>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="..\..\Wolverine\Wolverine.csproj" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Bobcat.EventModel" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    </ItemGroup>
    <ItemGroup>
        <!-- The Bobcat a generated spec project pins by default: the one this package is built against -->
        <AssemblyMetadata Include="BobcatVersion" Value="@(PackageVersion->WithMetadataValue('Identity', 'Bobcat')->'%(Version)')" />
        <!-- The WolverineFx.Bobcat it pins by default: the version Wolverine.Bobcat.csproj packs as, from the one
             property both read (GH-5222). Not this package's own version, which may keep its own prerelease cadence. -->
        <AssemblyMetadata Include="WolverineFxBobcatVersion" Value="$(WolverineFxBobcatPackageVersion)" />
    </ItemGroup>
    <ItemGroup>
        <InternalsVisibleTo Include="Wolverine.Bobcat.EventModel.Tests" />
    </ItemGroup>
</Project>
