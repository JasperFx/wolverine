<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
        <IsAotCompatible>false</IsAotCompatible>
        <NoWarn>$(NoWarn);NU1202;NETSDK1005</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Bobcat.Xunit" />
        <!-- The source generator: marker comments, and the spec manifest the bobcat tool lists from -->
        <PackageReference Include="Bobcat.Generators" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="Shouldly" />
        <PackageReference Include="xunit.v3"/>
        <PackageReference Include="xunit.runner.visualstudio">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>

    <!-- Marten, for now: the helpers are store-agnostic over JasperFx.Events.IEventStore, which the
         in-memory prototyping store does not implement yet (JasperFx/jasperfx#985). When it does, these
         tests gain an in-memory lane that needs no database. -->
    <ItemGroup>
        <ProjectReference Include="..\Wolverine.Bobcat\Wolverine.Bobcat.csproj" />
        <ProjectReference Include="..\..\Persistence\Wolverine.Marten\Wolverine.Marten.csproj" />
        <!-- GH-4892: the aggregate-less arrange runs against every store, not only Marten -->
        <ProjectReference Include="..\..\Persistence\Wolverine.Polecat\Wolverine.Polecat.csproj" />
        <ProjectReference Include="..\..\Persistence\Wolverine.Fisher\Wolverine.Fisher.csproj" />
        <ProjectReference Include="..\..\Wolverine.RuntimeCompilation\Wolverine.RuntimeCompilation.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Compile Include="..\..\Servers.cs">
            <Link>Servers.cs</Link>
        </Compile>
    </ItemGroup>

</Project>
