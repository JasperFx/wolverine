<Project Sdk="Microsoft.NET.Sdk">

    <!--
      bobcat#471: CritterStackScenario, the store-only projected vocabulary, against two real stores with NO
      message bus registered: Marten on this repository's docker-compose Postgres ([PostgresFact], skipped
      locally when absent and never on CI) and Fisher on a temp SQLite file (never skipped). The project
      references WolverineFx.Bobcat, which is where the vocabulary ships since GH-5082 (it moved here from
      Bobcat core, JasperFx/bobcat#744), but no test registers Wolverine: a pass still proves the vocabulary
      needs no message bus.

      Also the home of the store-binding tests that need no store at all (EventStores, RecordBuilding,
      EventStoreAuthoring against fakes).
    -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
        <IsAotCompatible>false</IsAotCompatible>
        <!-- C# 13, as Bobcat built these tests -->
        <LangVersion>13</LangVersion>
        <!-- Moved from Bobcat (GH-5082), which did not run these analyzers as errors: xUnit1051 (pass the test's
             cancellation token) and VSTHRD110 (NSubstitute's Received().SomethingAsync() verifications). -->
        <NoWarn>$(NoWarn);NU1202;NETSDK1005;CS0419;xUnit1051;VSTHRD110;CS8981</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="xunit.v3" />
        <PackageReference Include="Shouldly" />
        <PackageReference Include="NSubstitute" />
        <PackageReference Include="Marten" />
        <PackageReference Include="Fisher" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="xunit.runner.visualstudio">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <!-- Marten and Fisher each bundle JasperFx.Events.SourceGenerator in their own nupkg, so referencing
             both loads the generator twice (CS0433, jasperfx#462). Compile with the explicit, centrally pinned
             generator instead; the target below drops every store-bundled copy. -->
        <PackageReference Include="JasperFx.Events.SourceGenerator"
                          OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
    </ItemGroup>

    <Target Name="DropDuplicateBundledEventSourceGenerator" BeforeTargets="CoreCompile">
        <ItemGroup>
            <Analyzer Remove="@(Analyzer)"
                      Condition="'%(Filename)' == 'JasperFx.Events.SourceGenerator' and ($([System.String]::Copy('%(Identity)').Replace('\', '/').Contains('/marten/')) or $([System.String]::Copy('%(Identity)').Replace('\', '/').Contains('/fisher/')) or $([System.String]::Copy('%(Identity)').Replace('\', '/').Contains('/polecat/')))" />
        </ItemGroup>
    </Target>

    <ItemGroup>
        <ProjectReference Include="..\Wolverine.Bobcat\Wolverine.Bobcat.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Compile Include="..\..\Servers.cs">
            <Link>Servers.cs</Link>
        </Compile>
    </ItemGroup>

</Project>
