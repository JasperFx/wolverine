<Project Sdk="Microsoft.NET.Sdk">

    <!--
      GH-5082: the spec writer's tests, which moved here from Bobcat.EventModel.Tests with the writer
      (JasperFx/bobcat#755): EmlangSpecWriterTests, SpecProjectWriterTests, DeclaredIdentityTests, the
      specification arm of ImportMergeTests, and the specification halves of the import tests that asserted on
      stubs and specifications together.
    -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
        <IsAotCompatible>false</IsAotCompatible>
        <LangVersion>13</LangVersion>
        <!-- Moved from Bobcat, which did not run these analyzers as errors -->
        <NoWarn>$(NoWarn);NU1202;NETSDK1005;CS0419;xUnit1051;CS8981</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="xunit.v3" />
        <PackageReference Include="Shouldly" />
        <!-- Only to read the Bobcat version a generated spec project is pinned to -->
        <PackageReference Include="Bobcat" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="xunit.runner.visualstudio">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Wolverine.Bobcat.EventModel\Wolverine.Bobcat.EventModel.csproj" />
    </ItemGroup>

</Project>
