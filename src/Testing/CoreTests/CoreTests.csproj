<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="FluentResults" />
        <PackageReference Include="Lamar.Microsoft.DependencyInjection" />
        <PackageReference Include="Microsoft.FeatureManagement"/>
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="OpenTelemetry.Exporter.Console"/>
        <PackageReference Include="xunit.v3"/>
        <PackageReference Include="xunit.runner.visualstudio">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="GitHubActionsTestLogger" PrivateAssets="All" />
        <!-- GH-5601: the node workload specifications (Runtime/Agents/Workloads) are Bobcat specifications, so they
             render as Given/When/Then: the session hook (Bobcat.Xunit's props) and the generator that records each
             step. Every other test here is an ordinary xUnit test and is untouched by either. -->
        <PackageReference Include="Bobcat.Xunit" />
        <PackageReference Include="Bobcat.Generators" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Module2\Module2.csproj"/>
        <ProjectReference Include="..\OrderExtension\OrderExtension.csproj"/>
        <ProjectReference Include="..\Module1\Module1.csproj"/>
        <ProjectReference Include="..\Wolverine.ComplianceTests\Wolverine.ComplianceTests.csproj" />
        <ProjectReference Include="..\..\Wolverine.RuntimeCompilation\Wolverine.RuntimeCompilation.csproj" />
        <!-- Test surface still exercises the Newtonsoft serialization shape. -->
        <ProjectReference Include="..\..\Extensions\Wolverine.Newtonsoft\Wolverine.Newtonsoft.csproj" />
    </ItemGroup>

    <!--
      GH-5403. The analyzer tests in Analyzers/ instantiate WolverineFx.Analyzers' analyzers directly. Directory.Build.targets
      already references the project as an analyzer (which builds it first), and a second ProjectReference to the same
      project is NU1504, so the built assembly is referenced by path. It is netstandard2.0 whatever the configuration.
    -->
    <ItemGroup>
        <Reference Include="Wolverine.Analyzers">
            <HintPath>..\..\Wolverine.Analyzers\bin\$(Configuration)\netstandard2.0\Wolverine.Analyzers.dll</HintPath>
        </Reference>
    </ItemGroup>

    <ItemGroup>
        <Content Include="$(SolutionDir)xunit.runner.json" CopyToOutputDirectory="PreserveNewest"/>
        <Content Update="appsettings.json">
            <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        </Content>
    </ItemGroup>

    <ItemGroup>
      <Compile Remove="Internal\Generated\WolverineHandlers\SayStuffHandler1292291056.cs" />
      <Compile Remove="Internal\Generated\WolverineHandlers\CSP4Handler299410023.cs" />
    </ItemGroup>
</Project>
