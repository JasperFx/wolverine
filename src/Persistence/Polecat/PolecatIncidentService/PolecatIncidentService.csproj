<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFrameworks>net10.0</TargetFrameworks>
        <NoWarn>$(NoWarn);NU1202;NETSDK1005</NoWarn>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
        <PackageReference Include="JasperFx" />
        <!-- The JasperFx.Events source generator must run on THIS assembly so the
             AggregateEvolver / projection dispatchers are emitted (there is no runtime
             fallback). Reference it explicitly so it always runs; the target below drops
             Polecat's bundled duplicate copy where it also flows. Matches PolecatTests. -->
        <PackageReference Include="JasperFx.Events.SourceGenerator" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\..\..\Http\Wolverine.Http.Polecat\Wolverine.Http.Polecat.csproj" />
    </ItemGroup>

  <!-- JasperFx.Events.SourceGenerator is bundled inside the Polecat nupkg (analyzers/dotnet/cs/)
       AND referenced explicitly above. When both copies are the identical version they load as two
       analyzer instances, each emitting every projection's .Evolver dispatcher into this assembly,
       so the compile fails with CS0433 ("type exists in both PolecatIncidentService and
       PolecatIncidentService"). The generator dedupes within a single instance but cannot
       coordinate across two instances. Drop the Polecat-bundled copy and keep the explicit one —
       the kept copy is the same store-agnostic generator and still emits dispatchers for every
       projection in the compilation.

       This only began biting when Polecat moved to 5.12.0, whose bundled generator is 2.47.0 —
       the same version this repo pins explicitly. Under Polecat 5.7.0 the two differed, so only
       one instance loaded. PolecatTests has carried the identical target since it hit this first;
       this project needs it for the same reason and was simply not yet exercised against a
       matching pair. -->
  <Target Name="DropDuplicateBundledEventSourceGenerator" BeforeTargets="CoreCompile">
    <ItemGroup>
      <Analyzer Remove="@(Analyzer)"
                Condition="'%(Filename)' == 'JasperFx.Events.SourceGenerator' and $([System.String]::Copy('%(Identity)').Replace('\', '/').Contains('/polecat/'))" />
    </ItemGroup>
  </Target>

</Project>
