<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Description>EF Core-backed Persistence for Wolverine Applications</Description>
        <Authors>Jeremy D. Miller, Mark Warpool</Authors>
        <PackageId>WolverineFx.EntityFrameworkCore</PackageId>
        <GenerateAssemblyProductAttribute>false</GenerateAssemblyProductAttribute>
        <GenerateAssemblyCopyrightAttribute>false</GenerateAssemblyCopyrightAttribute>
        <GenerateAssemblyVersionAttribute>false</GenerateAssemblyVersionAttribute>
        <GenerateAssemblyFileVersionAttribute>false</GenerateAssemblyFileVersionAttribute>
        <GenerateAssemblyInformationalVersionAttribute>false</GenerateAssemblyInformationalVersionAttribute>
        <!--
          AOT-compatible (#2746). Reflective surface resolved via class-level
          [UnconditionalSuppressMessage] on the codegen frame providers / saga
          diagnostics / tenanted DbContext builders, plus a forwarded
          [DAM(PublicConstructors|NonPublicConstructors|PublicProperties)] on
          AddDbContextWithWolverineIntegration<T> to satisfy EF Core's own
          AddDbContext<TContext> requirement.
        -->
        <IsAotCompatible>true</IsAotCompatible>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.EntityFrameworkCore"/>
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design"/>
        <PackageReference Include="Microsoft.EntityFrameworkCore.Relational"/>
        <PackageReference Include="Weasel.EntityFrameworkCore" />
        <ProjectReference Include="..\Wolverine.RDBMS\Wolverine.RDBMS.csproj"/>
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
        <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" />
        <!-- Unify EF Core Design's transitive Roslyn (CSharp.Workspaces 4.8.0) up to the
             solution's 4.14.0 line. Previously masked by core WolverineFx's JasperFx.RuntimeCompiler
             reference, removed in #2876. Flows transitively to the EF sample/test projects. -->
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" />
        <PackageReference Include="Microsoft.Build.Tasks.Core" />
        <!-- NOTE (GH-4773): Workspaces.MSBuild 4.14.0 above drags System.Security.Cryptography.Pkcs
             7.0.2, whose net7.0 assets depend on System.Formats.Asn1 7.0.0 - vulnerable under
             GHSA-447r-wph3-92pm / CVE-2024-38095 (HIGH). It is harmless in every project that
             multi-targets, because SDK 10 turns package pruning on for those and the stale 7.0.0 is
             pruned away; it only survives in SINGLE-TFM net9.0 projects, where pruning is off by
             default. Those projects pin System.Formats.Asn1 directly - see the four csproj/fsproj
             files listed in the Directory.Packages.props note. Deliberately NOT pinned here: a
             direct reference in this project is pruned out of the generated nuspec anyway, so it
             would buy published consumers nothing while adding a reference NU1510 flags. -->
    </ItemGroup>

    <ItemGroup>
        <Folder Include="obj\Debug\netstandard2.1"/>
    </ItemGroup>

</Project>
