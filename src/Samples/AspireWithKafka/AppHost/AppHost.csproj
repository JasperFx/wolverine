<Project Sdk="Aspire.AppHost.Sdk/13.6.3">

  <!-- Keep the SDK version above and the Aspire.Hosting.* versions in the root
       Directory.Packages.props on the same Aspire release. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- ASPIRE010: this sample runs with `dotnet run` on the dashboard and orchestrator packages the
         SDK references for us, not the Aspire CLI bundle -->
    <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.Kafka" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Publisher/Publisher.csproj" />
    <ProjectReference Include="../Consumer/Consumer.csproj" />
  </ItemGroup>

</Project>
