<Project Sdk="Microsoft.NET.Sdk">

    <!-- GH-5553 / GH-5554 / GH-5556 (Wolverine 7.0): Fault<T> back to the saga that sent T, durable faults and saga
         compensation, written as Bobcat specifications FIRST. Two services in one test process, "orders" (the Order
         saga) and "inventory", over TCP, each with its own Marten store. The specifications are Acceptance specs until
         the features are built: they run every time and report as skipped while they fail. -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <TargetFrameworks>net10.0</TargetFrameworks>
        <IsAotCompatible>false</IsAotCompatible>
        <NoWarn>$(NoWarn);NU1202;NETSDK1005</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Bobcat.Xunit" />
        <!-- The source generator: marker comments, and the spec manifest the bobcat tool lists from -->
        <PackageReference Include="Bobcat.Generators" />
        <PackageReference Include="Shouldly" />
        <PackageReference Include="xunit.v3" />
        <!-- IDE discovery (Rider, Visual Studio): Bobcat warns BOBCAT033 without these -->
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="xunit.runner.visualstudio">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\..\Bobcat\Wolverine.Bobcat\Wolverine.Bobcat.csproj" />
        <ProjectReference Include="..\..\..\Persistence\Wolverine.Marten\Wolverine.Marten.csproj" />
        <ProjectReference Include="..\..\..\Wolverine.RuntimeCompilation\Wolverine.RuntimeCompilation.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Compile Include="..\..\..\Servers.cs">
            <Link>Servers.cs</Link>
        </Compile>
    </ItemGroup>

</Project>
