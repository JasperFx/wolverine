<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <!-- EF Core and its Npgsql provider stay on the 10.x line on net11.0 too (see Directory.Packages.props);
             until Npgsql.EntityFrameworkCore.PostgreSQL 11 ships GA
             (its rc pins an exact RC EF Core) -->
        <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
        <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Http\Wolverine.Http\Wolverine.Http.csproj" />
        <ProjectReference Include="..\..\Persistence\Wolverine.EntityFrameworkCore\Wolverine.EntityFrameworkCore.csproj" />
        <ProjectReference Include="..\..\Persistence\Wolverine.Postgresql\Wolverine.Postgresql.csproj" />
        <!-- Wolverine 6.0 no longer ships the Roslyn runtime compiler in the core
             package. Referencing WolverineFx.RuntimeCompilation auto-registers it
             for TypeLoadMode.Dynamic (the default for development) -->
        <ProjectReference Include="..\..\Wolverine.RuntimeCompilation\Wolverine.RuntimeCompilation.csproj" />
    </ItemGroup>

</Project>
