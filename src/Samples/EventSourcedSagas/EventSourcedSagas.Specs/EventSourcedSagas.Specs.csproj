<Project Sdk="Microsoft.NET.Sdk">

    <!-- GH-5415 (Wolverine 7.0): first-class event-sourced sagas, written as Bobcat specifications first. One service,
         "fulfillment", with the OrderFulfillment saga of the process-manager docs page rebuilt as an EventSourcedSaga,
         on Marten, Polecat and Fisher. -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <TargetFrameworks>net10.0</TargetFrameworks>
        <IsAotCompatible>false</IsAotCompatible>
        <NoWarn>$(NoWarn);NU1202;NETSDK1005</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Bobcat.Xunit" />
        <!-- The source generator: marker comments, and the spec manifest the bobcat tool lists from -->
        <PackageReference Include="Bobcat.Generators" />
        <PackageReference Include="Shouldly" />
        <PackageReference Include="xunit.v3" />
        <!-- IDE discovery (Rider, Visual Studio): Bobcat warns BOBCAT033 without these -->
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="xunit.runner.visualstudio">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\..\Bobcat\Wolverine.Bobcat\Wolverine.Bobcat.csproj" />
        <ProjectReference Include="..\..\..\Persistence\Wolverine.Marten\Wolverine.Marten.csproj" />
        <ProjectReference Include="..\..\..\Persistence\Wolverine.Polecat\Wolverine.Polecat.csproj" />
        <ProjectReference Include="..\..\..\Persistence\Wolverine.Fisher\Wolverine.Fisher.csproj" />
        <ProjectReference Include="..\..\..\Wolverine.RuntimeCompilation\Wolverine.RuntimeCompilation.csproj" />
    </ItemGroup>

    <!-- ReturnRequest's Evolve() uses bare case labels (`case ReturnedItemsReceived:`), which the JasperFx.Events source
         generator reads from 3.9.0 on. Marten 10.0.0-alpha.6, Polecat 6.0.0-alpha.8 and Fisher 2.0.0-alpha.6 still bundle
         the 3.8.0 generator; a direct reference wins over the bundled copies. Drop this once the stores bundle 3.9.0. -->
    <ItemGroup>
        <PackageReference Include="JasperFx.Events.SourceGenerator"
                          OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup>
        <Compile Include="..\..\..\Servers.cs">
            <Link>Servers.cs</Link>
        </Compile>
    </ItemGroup>

</Project>
