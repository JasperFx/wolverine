<Project Sdk="Aspire.AppHost.Sdk/13.6.5">

  <!-- Keep the SDK version above and the Aspire.Hosting.* versions in the root
       Directory.Packages.props on the same Aspire release. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Clears the net10.0;net11.0 the root Directory.Build.props sets. Beside it, a TargetFramework alone leaves
         the project multi-targeted, and `dotnet run` (which is how the AppHost starts a project) refuses it with
         "Your project targets multiple frameworks" -->
    <TargetFrameworks></TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- ASPIRE010: this sample runs with `dotnet run` on the dashboard and orchestrator packages the
         SDK references for us, not the Aspire CLI bundle -->
    <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- WolverineFx.Aspire.Hosting.Pubsub as a NuGet package in your own AppHost. It is a library, not a
         service, so it is not an Aspire project resource. -->
    <ProjectReference Include="../../../Transports/GCP/Wolverine.Aspire.Hosting.Pubsub/Wolverine.Aspire.Hosting.Pubsub.csproj"
                      IsAspireProjectResource="false" />
    <ProjectReference Include="../Pinger/AspireWithPubsub.Pinger.csproj" />
  </ItemGroup>

</Project>
