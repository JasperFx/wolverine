<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net9.0</TargetFrameworks>
        <RootNamespace>GreeterCodeFirstGrpc.Messages</RootNamespace>
        <AssemblyName>GreeterCodeFirstGrpc.Messages</AssemblyName>
    </PropertyGroup>

    <!-- Contracts only: protobuf-net.Grpc for [ServiceContract] and [ProtoContract]. No reference to
         WolverineFx.Grpc, so clients that bind IGreeterCodeFirstService do not pull in the server
         hosting stack. The Server project registers the contract with Wolverine instead (GH-4396). -->
    <ItemGroup>
        <PackageReference Include="protobuf-net.Grpc"/>
    </ItemGroup>

</Project>
