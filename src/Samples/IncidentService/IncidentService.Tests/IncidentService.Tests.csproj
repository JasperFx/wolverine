<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <IsPackable>false</IsPackable>
        <TargetFrameworks>net10.0</TargetFrameworks>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Alba" />
        <PackageReference Include="Bobcat.Xunit" />
        <!-- The source generator: marker comments, and the spec manifest the bobcat tool lists from -->
        <PackageReference Include="Bobcat.Generators" />
        <PackageReference Include="Shouldly" />
        <!-- Bobcat.Xunit 0.60.0 needs xunit.v3 4.x on Microsoft.Testing.Platform 2.x; the rest of the repo stays on 3.x -->
        <PackageReference Include="xunit.v3" VersionOverride="$(XunitV3ForBobcatVersion)" />
        <!-- IDE discovery (Rider, Visual Studio): Bobcat warns BOBCAT033 without these. The command line and CI run
             the MTP test host directly. -->
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="xunit.runner.visualstudio">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="coverlet.collector">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\IncidentService\IncidentService.csproj" />
      <ProjectReference Include="..\..\..\Bobcat\Wolverine.Bobcat.Http\Wolverine.Bobcat.Http.csproj" />
    </ItemGroup>
</Project>